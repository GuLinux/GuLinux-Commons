#!/bin/bash
function usage() {
    echo "Usage: `basename $0` filename [interpreter path]"
    exit 0
}

SCRIPT_FILE="$1"; shift
SCRIPT_FILE_EXT="${SCRIPT_FILE##*.}"

case "$SCRIPT_FILE_EXT" in
    py)
        DEFAULT_INTERPRETER="python3"
        ;;
    *)
        DEFAULT_INTERPRETER="bash"
        ;;
esac

if test "x$SCRIPT_FILE" == "x"; then
    usage
fi


INTERPRETER="$@"
if [ -z "$INTERPRETER" ]; then
    INTERPRETER="/usr/bin/env $DEFAULT_INTERPRETER"
fi

if [ -r $SCRIPT_FILE ]; then
    echo "File $SCRIPT_FILE already present, opening"
    vim $SCRIPT_FILE
    exit 0
fi

cat >$SCRIPT_FILE <<EOF
#!$INTERPRETER

EOF

chmod +x $SCRIPT_FILE
vim $SCRIPT_FILE +2

